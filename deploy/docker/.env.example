# ─────────────────────────────────────────────────────────────────────────────
#  douyin-pipeline 容器部署配置
#
#  用法：cp .env.example .env  →  按需改下面几项  →  docker compose up -d
#  这个文件**不含任何凭据**：LLM 密钥仍然只存在宿主机
#  D:\视频\媒体知识库\_llm_config.sh 里（由容器启动时 source 进去）。
# ─────────────────────────────────────────────────────────────────────────────

# ── 镜像 ──
TAG=5.8
# 时区：容器内定时任务按这个时区跑（默认北京时间）
TZ=Asia/Shanghai

# ── 宿主机目录 → 容器挂载点 ──────────────────────────────────────────────
# 左边是 **Windows 宿主路径**，右边是容器内路径。
# ⚠ 右边的值必须和 wb_compat.py 的默认挂载点一致，改了要同步改 compose 与 compat。
WB_HOST_VIDEO_LIB=D:/视频/自媒体视频库
WB_HOST_MEDIA_KB=D:/视频/媒体知识库
WB_HOST_VIDEOS_DATA=C:/Users/EDY/Videos/data
WB_HOST_VCA_DIR=C:/Users/EDY/Projects/video-analyzer
WB_HOST_ALIST_DIR=D:/alist
WB_HOST_KB_REPO=D:/视频/自媒体脚本知识库

WB_VIDEO_LIB=/mnt/video-lib
WB_MEDIA_KB=/mnt/media-kb
WB_VIDEOS_DATA=/mnt/videos-data
WB_VCA_DIR=/mnt/vca
WB_ALIST_DIR=/mnt/alist
WB_KB_REPO=/mnt/kb-repo

# ── 看板端口 ──
WB_UI_PORT=8770

# ── 端口中继（socat）────────────────────────────────────────────────────
# 实盘脚本把 ASR / alist 地址硬编码成 127.0.0.1，容器里靠 socat 把
# 127.0.0.1:<port> 转发到宿主机，从而**零代码改动**接上宿主服务。
#   · 8766  ASR 引擎（VideoAnalyzer-Transcribe）
#   · 5244  alist
#   · 11434 Ollama（仅 WB_LLM_BACKEND=ollama 时才需要）
WB_RELAY_PORTS=8766,5244
WB_RELAY_TARGET=host.docker.internal

# ── LLM / 转写配置 ───────────────────────────────────────────────────────
# 与 Windows 同一套做法：source 宿主机那份 _llm_config.sh（唯一生效位置）。
# 设为 none 则不 source，完全依赖下面这些环境变量。
WB_LLM_CONFIG_FILE=/mnt/media-kb/_llm_config.sh

# 数据源：lib = 自媒体视频库（**必须**，否则退回旧源「关注」）
WB_SOURCE=lib
# 只在 WB_LLM_CONFIG_FILE=none 时才需要手填：
# WB_LLM_BACKEND=cloud
# WB_CLOUD_BASE=https://api.siliconflow.com/v1
# WB_CLOUD_KEY=
# WB_CLOUD_MODEL=deepseek-ai/DeepSeek-V4-Flash
# WB_CLOUD_DISABLE_THINK=1

# ── 采集侧参数 ──
# 磁盘闸门（GB）：D: 剩余低于它就跳过下载（脚本内置默认 20）
MIN_FREE_GB=20

# ── 容器内定时任务 ───────────────────────────────────────────────────────
# 与宿主机现有两条自动化对齐：18:00 采集链 / 19:05 转写链 / 20:00 上传
# 格式：逗号分隔的 HH:MM|步骤，步骤见 wbctl.sh（harvest / transcribe / upload）
WB_SCHEDULE=18:00|harvest,19:05|transcribe,20:00|upload
# 到点前随机的额外抖动秒数（0 = 准点），避免多机部署撞车
WB_SCHEDULE_JITTER=0

# ── 权限 ──
# 写 bind mount 报 Permission denied 时，把下面两行改成 0:0 用 root 跑（README 有说明）
WB_RUN_USER=

# ── 资源上限 ──
WB_HARVEST_MEM=2g
WB_KB_MEM=2g
